{
    "name": "contactjavas/modern-wpcs-standard",
    "description": "A set of phpcs sniffs for modern php development.",
    "type": "phpcodesniffer-standard",
    "keywords" : [ "phpcs", "static analysis" ],
    "license": "MIT",
    "authors": [
        {
            "name": "Bagus",
            "email": "contactjavas@gmail.com"
        },
        {
            "name": "Payton Swick",
            "email": "payton@foolord.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "./vendor/bin/phpunit --testdox",
        "lint": "./vendor/bin/phpcs ModernWpcsStandard"
    },
    "support"    : {
        "issues": "https://github.com/contactjavas/modern-wpcs-standard/issues",
        "wiki"  : "https://github.com/contactjavas/modern-wpcs-standard/wiki",
        "source": "https://github.com/contactjavas/modern-wpcs-standard"
    },
    "config": {
        "sort-order": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "ModernWpcsStandard\\": "ModernWpcsStandard/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ModernWpcsStandard\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
        "squizlabs/php_codesniffer": "^4.0.1"
    },
    "require-dev": {
        "sirbrillig/phpcs-variable-analysis": "^2.13.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "phpunit/phpunit": "^13.2.4"
    }
}
